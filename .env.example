# Copy this file to .env and fill in your own values. Never commit .env.

# --- Email sending (Outlook/Office365 by default) ---
# The email address you'll send applications from.
EMAIL_ADDRESS=your.email@example.com
# This is NOT your regular account password. It's an app password:
# an app-specific passcode you generate from your Microsoft account
# security settings (Security -> Advanced security options -> App passwords).
EMAIL_APP_PASSWORD=your_app_password_here
# Uncomment/change if you're not using Outlook/Office365.
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587

# --- LLM provider ---
# Used to write the emails and to filter which internships are relevant to you.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# LLM_PROVIDER=google        # "google" (default) or "ollama" for a local/self-hosted model
# LLM_MODEL=gemini-2.0-flash # model name for the chosen provider

# --- Candidate info ---
CANDIDATE_NAME=Your Name
# Path to your CV, used both as the email attachment and read by nothing else.
CV_FILE=cv.pdf
# Where your background/skills/experience text lives (see profile.example.txt).
PROFILE_FILE=profile.txt

# --- Application behavior ---
# Comma-separated list of fields/topics an internship must match to get an email.
# RELEVANCE_TOPICS=AI, Machine Learning, Data Science, Deep Learning, NLP, Computer Vision
# MAX_EMAIL_WORDS=200

# --- Leads CSV ---
# LEADS_FILE=leads.csv
# CSV_SUBJECT_COLUMN=subject
# CSV_COMPANY_COLUMN=company
# CSV_EMAIL_COLUMN=email

# --- Sending pace (seconds between emails, randomized in this range) ---
# EMAIL_DELAY_MIN_SECONDS=240
# EMAIL_DELAY_MAX_SECONDS=300

# Row index to resume from if a previous run was interrupted.
# START_ROW=0
